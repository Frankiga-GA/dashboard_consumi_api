<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Dashboard</title>
  <!-- Cargar Chart.js -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script> 
  <style>
    body {
      font-family: Arial, sans-serif;
      margin: 40px;
    }

    h1, h2 {
      color: #333;
    }

    canvas {
      max-width: 600px;
      margin-top: 20px;
    }

    .section {
      margin-top: 40px;
    }

    .screenshot {
      margin-top: 10px;
    }

    .screenshot img {
      max-width: 400px;
      border: 1px solid #ccc;
      border-radius: 5px;
      margin-bottom: 10px;
    }

    pre {
      background: #f4f4f4;
      padding: 15px;
      border-radius: 5px;
      white-space: pre-wrap;
      word-wrap: break-word;
    }
  </style>
</head>
<body>

  <h1>📊 Dashboard de Reunión</h1>

  <!-- Datos inyectados desde el backend -->
  <div id="app" style="display:none;" data-api='<%= data %>'></div>

  <!-- Gráfico de Participantes -->
  <canvas id="participantsChart" width="400" height="200"></canvas>

  <!-- Sección: Transcripción -->
  <div class="section">
    <h2>📄 Transcripción de la Reunión</h2>
    <pre id="transcription-text">Cargando transcripción...</pre>
  </div>

  <!-- Sección: Capturas de Pantalla -->
  <div class="section">
    <h2>🖼️ Capturas de la Reunión</h2>
    <div id="screenshot-container">
      <p>Cargando capturas...</p>
    </div>
  </div>

  <script>
    const appDiv = document.getElementById('app');
    const rawData = appDiv.getAttribute('data-api');

    let dataFromServer = null;

    try {
      dataFromServer = JSON.parse(rawData);
    } catch (e) {
      console.error('Error al parsear los datos:', e);
    }

    if (!dataFromServer || !Array.isArray(dataFromServer.participants)) {
      console.warn("Datos inválidos o sin participantes");
    } else {
      // === Gráfico de Participantes ===
      const labels = dataFromServer.participants.map((p, i) => `Participante ${i + 1}`);
      const values = new Array(dataFromServer.participants.length).fill(1);

      const ctx = document.getElementById('participantsChart').getContext('2d');
      new Chart(ctx, {
        type: 'bar',
        data: {
          labels: labels,
          datasets: [{
            label: 'Número de Participantes',
            data: values,
            backgroundColor: 'rgba(76, 187, 155, 0.6)'
          }]
        },
        options: {
          responsive: true,
          plugins: {
            legend: { display: false }
          },
          scales: {
            y: {
              beginAtZero: true,
              ticks: {
                stepSize: 1
              }
            }
          }
        }
      });

      // === Mostrar Transcripción ===
      const transcriptionText = document.getElementById('transcription-text');
      transcriptionText.textContent = dataFromServer.transcription || 'No disponible';

      // === Mostrar Capturas ===
      const screenshotContainer = document.getElementById('screenshot-container');
      screenshotContainer.innerHTML = ''; // Limpiar mensaje de carga

      if (Array.isArray(dataFromServer.screenshots)) {
        dataFromServer.screenshots.forEach(url => {
          const div = document.createElement('div');
          div.className = 'screenshot';
          div.innerHTML = `<img src="${url}" alt="Captura">`;
          screenshotContainer.appendChild(div);
        });
      } else {
        screenshotContainer.innerHTML = '<em>No hay capturas disponibles.</em>';
      }
    }
  </script>

</body>
</html>